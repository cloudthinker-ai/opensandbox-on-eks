# --- Testing (cheapest) ---
create_cluster     = true
cluster_name       = "opensandbox"
region             = "us-east-1"
cluster_version    = "1.29"
node_instance_type = "t3.small"    # ~$0.02/hr per node
node_min_size      = 1
node_max_size      = 2
node_desired_size  = 1             # Single node for testing

# --- Existing cluster — uncomment and set: ---
# create_cluster = false
# cluster_name   = "my-existing-cluster"
# install_ebs_csi             = false  # skip if already installed
# install_snapshot_controller = false  # skip if already installed
# enable_network_policy       = false  # skip if already enabled
